{
  "name": "productivity-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.cpSync('src/popup.html','dist/popup.html'); fs.cpSync('src/farm.html','dist/farm.html'); if (fs.existsSync('src/assets')) fs.cpSync('src/assets','dist/assets',{recursive:true}); fs.cpSync('manifest.json','dist/manifest.json');\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
